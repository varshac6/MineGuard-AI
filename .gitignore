# Ignore these files/folders

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.o
*.exe
*.dll
*.so
build/
dist/

# Node.js
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
venv/
.env

# Large binary files (over 50MB)
*.bin
*.hex
*.iso

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
npm-debug.log
